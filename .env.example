# OpenAI Platform runtime API key used only by tunnel-client.
# Create it at https://platform.openai.com/settings/organization/api-keys
CONTROL_PLANE_API_KEY=replace_with_your_runtime_api_key

# Create a tunnel at https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_with_your_tunnel_id

# Local MCP endpoint forwarded by tunnel-client.
MCP_SERVER_URL=url=http://127.0.0.1:18765/mcp,channel=main

# Luna local settings. Keep the port above 10000 to reduce collisions.
MCP_HOST=127.0.0.1
MCP_PORT=18765
MCP_MAX_FILE_BYTES=1048576
MCP_MAX_BATCH_BYTES=8388608
MCP_MAX_COMMAND_OUTPUT_BYTES=262144
MCP_MAX_CHECKPOINT_FILES=5000
MCP_MAX_CHECKPOINT_BYTES=134217728
MCP_MAX_CHECKPOINTS=20
MCP_MAX_ARTIFACT_BYTES=26214400
MCP_MAX_OPERATION_ENTRIES=10000

# Optional private state directory. It must remain outside every authorized workspace.
# LUNA_STATE_DIR=C:\Users\YourName\AppData\Local\LunaUnlimited
